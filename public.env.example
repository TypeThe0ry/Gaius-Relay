# Both names must resolve to this host before Caddy can obtain certificates.
GAIUS_RELAY_DOMAIN=relay.example.com
GAIUS_REGISTRY_DOMAIN=registry.example.com

# Include the hosted client origin and null for downloaded file:// clients.
GAIUS_ALLOWED_ORIGINS=https://play.example.com,null

# Generate with: openssl rand -hex 32
GAIUS_REGISTRY_TOKEN=runtime-generated-token

GAIUS_RELAY_NODE_ID=example-public-1
GAIUS_RELAY_NODE_NAME=Example Public RelayNode
GAIUS_RELAY_PRIORITY=0
GAIUS_MAXIMUM_CONNECTIONS=256
